# 追加到项目根目录 .env（与闲鱼服务共用）。生成随机值：openssl rand -hex 32

COMPOSE_FILE=docker-compose.yml:docker-compose.gateway.yml

# /api/v1/messages/send 的秘钥（backend-web 与网关共用）
MESSAGE_SEND_API_KEY=

# 网关鉴权：agent 调用 /mcp、/status 的 Bearer token
GATEWAY_BOT_TOKEN=
# 闲鱼默认回复回调路径密钥：/hook/<secret>
GATEWAY_HOOK_SECRET=

# 事件推送目标（agent 的 webhook）
AGENT_WEBHOOK_URL=
AGENT_WEBHOOK_TOKEN=
# 请求头为 <HEADER>: <SCHEME> <TOKEN>；SCHEME 留空则直接发送 token
AGENT_WEBHOOK_AUTH_HEADER=Authorization
AGENT_WEBHOOK_AUTH_SCHEME=Bearer

# true 只记录拟回复不发送；验证回复质量后改为 false
SHADOW_MODE=true

# 可选
# GATEWAY_PORT=8788
# GATEWAY_DATA_DIR=./xianyu-gateway/data
# GATEWAY_DEBOUNCE_SECONDS=3
# GATEWAY_ACK_TIMEOUT_SECONDS=600
